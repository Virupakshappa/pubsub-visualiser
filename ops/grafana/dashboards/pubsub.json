{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "title": "Pub/Sub Visualiser",
  "uid": "pubsub-visualiser",
  "tags": ["pubsub"],
  "timezone": "browser",
  "schemaVersion": 39,
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "5s",
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Publish rate (msg/s) by actor",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (actor) (rate(pubsub_messages_published_total[1m]))",
          "legendFormat": "{{actor}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Consume rate (msg/s) by actor",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (actor) (rate(pubsub_messages_consumed_total[1m]))",
          "legendFormat": "{{actor}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Processing latency p95 (ms) by actor",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, actor) (rate(pubsub_message_processing_duration_milliseconds_bucket[1m])))",
          "legendFormat": "{{actor}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Failures & retries (msg/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum (rate(pubsub_messages_failed_total[1m]))",
          "legendFormat": "failed (dead-lettered)"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum (rate(pubsub_messages_retries_total[1m]))",
          "legendFormat": "retries"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Connected SSE clients",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "none", "color": { "mode": "thresholds" } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(pubsub_sse_clients)",
          "legendFormat": "clients"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Total messages published",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(pubsub_messages_published_total)",
          "legendFormat": "published"
        }
      ]
    }
  ]
}
